{
	"Name": "Philips Hue",
	"Description": "Toggle Philips Hue lights, rooms and zones. Pair once with the hue CLI.",
	"Author": "l-lemaire",
	"Version": "0.1.0",
	"Icon": "icons/plugin",
	"Category": "Philips Hue",
	"CategoryIcon": "icons/plugin",
	"CodePaths": {
		"x86_64-unknown-linux-gnu": "x86_64-unknown-linux-gnu/bin/opendeck-hue",
		"aarch64-unknown-linux-gnu": "aarch64-unknown-linux-gnu/bin/opendeck-hue",
		"x86_64-apple-darwin": "x86_64-apple-darwin/bin/opendeck-hue",
		"aarch64-apple-darwin": "aarch64-apple-darwin/bin/opendeck-hue",
		"x86_64-pc-windows-msvc": "x86_64-pc-windows-msvc/bin/opendeck-hue.exe"
	},
	"CodePathLin": "x86_64-unknown-linux-gnu/bin/opendeck-hue",
	"CodePathMac": "x86_64-apple-darwin/bin/opendeck-hue",
	"CodePathWin": "x86_64-pc-windows-msvc/bin/opendeck-hue.exe",
	"OS": [
		{ "Platform": "linux" },
		{ "Platform": "mac", "MinimumVersion": "10.11" },
		{ "Platform": "windows", "MinimumVersion": "10" }
	],
	"Actions": [
		{
			"UUID": "com.github.l-lemaire.hue.toggle-light",
			"Name": "Toggle light",
			"Tooltip": "Switch one Hue light on or off",
			"Icon": "icons/light",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "propertyInspector/index.html",
			"States": [
				{ "Image": "icons/light-off", "Name": "Off", "TitleAlignment": "bottom", "FontSize": "9" },
				{ "Image": "icons/light-on", "Name": "On", "TitleAlignment": "bottom", "FontSize": "9" }
			]
		},
		{
			"UUID": "com.github.l-lemaire.hue.toggle-room",
			"Name": "Toggle room",
			"Tooltip": "Switch all lights of a Hue room on or off",
			"Icon": "icons/room",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "propertyInspector/index.html",
			"States": [
				{ "Image": "icons/room-off", "Name": "Off", "TitleAlignment": "bottom", "FontSize": "9" },
				{ "Image": "icons/room-on", "Name": "On", "TitleAlignment": "bottom", "FontSize": "9" }
			]
		},
		{
			"UUID": "com.github.l-lemaire.hue.toggle-zone",
			"Name": "Toggle zone",
			"Tooltip": "Switch all lights of a Hue zone on or off",
			"Icon": "icons/zone",
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": true,
			"DisableAutomaticStates": true,
			"PropertyInspectorPath": "propertyInspector/index.html",
			"States": [
				{ "Image": "icons/zone-off", "Name": "Off", "TitleAlignment": "bottom", "FontSize": "9" },
				{ "Image": "icons/zone-on", "Name": "On", "TitleAlignment": "bottom", "FontSize": "9" }
			]
		}
	]
}
